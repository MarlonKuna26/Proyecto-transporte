# Backend runtime
NODE_ENV=development
PORT=3002
API_URL=http://localhost:3002

# Database
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=u_ride_esp

# Auth
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRATION=30d

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3002

# Logging
LOG_LEVEL=debug

# Email (Gmail)
# App Password de Gmail (16 caracteres, sin espacios)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# SMTP opcional (si usas proveedor distinto)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
