{
  "name": "@u-ride/backend",
  "version": "1.0.0",
  "description": "U-Ride Backend - Node.js + Express + TypeScript",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "_moduleAliases": {
    "@": "dist",
    "@config": "dist/config",
    "@modules": "dist/modules",
    "@shared": "dist/shared"
  },
  "scripts": {
    "dev": "kill-port 3002 && concurrently \"tsc --watch\" \"tsx watch src/main.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "seed:data": "node scripts/seed-data.js",
    "test:apis": "node scripts/test-apis.js",
    "admin:reset": "node scripts/resetAdminPassword.js",
    "test:unit": "jest --config ./jest.unit.config.js --runInBand",
    "test:integration": "jest --config ./jest.integration.config.js --runInBand",
    "test": "npm run test:unit && npm run test:integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "merge:coverage": "node scripts/merge-coverage.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "module-alias": "^2.3.4",
    "nodemailer": "^6.10.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.23",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.55.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jest": "^29.7.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.1.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.9",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
