{
  "name": "u-ride",
  "version": "1.0.0",
  "description": "Ridesharing app for verified students - Clean Architecture Monorepo",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:watch": "pnpm -r --parallel run test:watch",
    "test:e2e": "pnpm --filter @u-ride/tests test:e2e",
    "cypress:open": "pnpm --filter @u-ride/tests cypress:open",
    "lint": "pnpm -r run lint",
    "format": "pnpm -r run format",
    "clean": "pnpm -r run clean && rm -rf node_modules pnpm-lock.yaml",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "install-global": "pnpm add -g pnpm",
    "pm2:setup": "pnpm add -g pm2 && pm2 install pm2-windows-startup",
    "pm2:start": "pnpm --filter @u-ride/backend build && pm2 start ecosystem.config.js",
    "pm2:save": "pm2 save",
    "pm2:stop": "pm2 stop ecosystem.config.js || true",
    "pm2:restart": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete ecosystem.config.js || true"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
}
